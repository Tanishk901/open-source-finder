# Copy this file to .env and fill in your keys. Never commit .env.
TYPESAFE_API_KEY=paste_your_key_here

# Optional: raises GitHub's rate limit from 60 to 5,000 requests/hour.
# A fine-grained token with no extra permissions is enough for public repos.
GITHUB_TOKEN=

# Optional: total spending cap in US dollars (default 5.00).
JEV_BUDGET_USD=5.00
